/* components/goods-card/goods-card.wxss —— 商品行视觉（步进器复用全局 .stepper） */
.goods-item { display: flex; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); position: relative; }
.goods-item.soldout { opacity: 0.55; }
.goods-pic { width: 150rpx; height: 150rpx; border-radius: var(--r-sm); overflow: hidden; background: #f3f3f3; margin-right: 18rpx; flex-shrink: 0; }
.goods-pic-img { width: 100%; height: 100%; display: block; }
.goods-info { flex: 1; min-width: 0; position: relative; }
.goods-name { font-size: 28rpx; font-weight: bold; }
.goods-desc { font-size: 22rpx; color: var(--sub); margin: 6rpx 0; }
.goods-sales { font-size: 22rpx; color: #aaa; margin-bottom: 10rpx; }
.goods-bottom { display: flex; align-items: center; justify-content: space-between; }
.goods-price { color: var(--theme); font-size: 32rpx; font-weight: bold; }
.soldout-mask {
  position: absolute; right: 0; bottom: 28rpx; background: rgba(0, 0, 0, 0.5);
  color: #fff; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx;
}
