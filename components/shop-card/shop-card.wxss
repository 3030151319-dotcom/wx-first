/* components/shop-card/shop-card.wxss —— 店铺卡片视觉（圆角 / 阴影 / 按压过渡） */
.shop-card {
  display: flex; background: var(--card); border-radius: var(--r-lg);
  padding: 20rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm);
  transition: transform 0.12s ease, background 0.12s ease;
}
.shop-cover { width: 200rpx; height: 200rpx; border-radius: var(--r-md); overflow: hidden; background: #f3f3f3; margin-right: 20rpx; flex-shrink: 0; }
.shop-cover-img { width: 100%; height: 100%; display: block; }
.shop-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.shop-name { font-size: 30rpx; font-weight: bold; }
.shop-meta { display: flex; align-items: center; font-size: 22rpx; color: var(--sub); margin: 12rpx 0; }
.shop-meta .rating { color: var(--gold); font-weight: bold; margin-right: 16rpx; }
.shop-meta .sales { margin-right: 16rpx; }
.shop-tags { display: flex; flex-wrap: wrap; margin-bottom: 8rpx; }
.shop-delivery { display: flex; align-items: center; font-size: 22rpx; color: var(--sub); margin-top: auto; }
.shop-delivery .fee { color: var(--theme); margin-right: 14rpx; }
.shop-delivery .time { margin-right: 14rpx; }
