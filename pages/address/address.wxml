<!-- pages/address/address.wxml -->
<view class="addr-page page-enter">
  <view wx:if="{{!showForm}}">
    <!-- 地址列表 -->
    <view wx:for="{{addresses}}" wx:key="id" class="addr-item" hover-class="press-card" data-addr="{{item}}" bindtap="selectAddr">
      <view class="ai-main">
        <view class="ai-line1">
          <text class="ai-name">{{item.name}}</text>
          <text class="ai-phone">{{item.phone}}</text>
          <text wx:if="{{item.tag}}" class="ai-tag">{{item.tag}}</text>
          <text wx:if="{{item.isDefault}}" class="ai-default">默认</text>
        </view>
        <view class="ai-detail ellipsis">{{item.region ? item.region + ' ' : ''}}{{item.detail}}</view>
      </view>
      <view class="ai-ops">
        <text class="ai-edit" data-addr="{{item}}" catchtap="editAddr">编辑</text>
        <text class="ai-del" data-id="{{item.id}}" catchtap="deleteAddr">删除</text>
      </view>
      <view wx:if="{{!from}}" class="ai-setdef {{item.isDefault ? 'on' : ''}}" data-id="{{item.id}}" catchtap="setDefault">
        {{item.isDefault ? '当前默认' : '设为默认'}}
      </view>
    </view>

    <mt-empty wx:if="{{addresses.length === 0}}" icon="📍" text="还没有收货地址" />

    <view class="add-btn" hover-class="btn-scale" bindtap="openForm">+ 新增收货地址</view>
  </view>

  <!-- 新增 / 编辑表单 -->
  <view wx:else class="addr-form">
    <view class="form-row">
      <text class="form-label">联系人</text>
      <input class="form-input" placeholder="姓名" value="{{form.name}}" data-field="name" bindinput="onField" />
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="11位手机号" type="number" maxlength="11" value="{{form.phone}}" data-field="phone" bindinput="onField" />
    </view>
    <view class="form-row">
      <text class="form-label">定位</text>
      <view class="loc-btn" bindtap="getLocation">📍 获取当前位置</view>
    </view>
    <view class="form-row">
      <text class="form-label">省市区</text>
      <picker mode="region" value="{{form.region}}" bindchange="onRegion">
        <view class="form-picker {{form.region.length ? '' : 'placeholder'}}">{{form.region.length ? form.region.join(' ') : '请选择省 / 市 / 区'}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">详细地址</text>
      <input class="form-input" placeholder="如：xx路 xx 号" value="{{form.detail}}" data-field="detail" bindinput="onField" />
    </view>
    <view class="form-row">
      <text class="form-label">标签</text>
      <view class="tag-group">
        <view wx:for="{{tags}}" wx:key="*this" class="form-tag {{form.tag === item ? 'active' : ''}}" data-tag="{{item}}" bindtap="pickTag">{{item}}</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">设为默认</text>
      <switch checked="{{form.isDefault}}" color="#FF5339" bindchange="onDefault" />
    </view>

    <view class="form-btns">
      <view class="form-cancel" bindtap="cancelForm">取消</view>
      <view class="form-save" bindtap="saveAddr">保存</view>
    </view>
  </view>
</view>
