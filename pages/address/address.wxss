/* pages/address/address.wxss */
.addr-page { padding: 20rpx; min-height: 100vh; background: var(--bg); }

.addr-item { background: var(--card); border-radius: var(--r-lg); padding: 24rpx; margin-bottom: 20rpx; position: relative; box-shadow: var(--shadow-sm); transition: transform 0.12s ease, background 0.12s ease; }
.ai-main { padding-right: 140rpx; }
.ai-line1 { display: flex; align-items: center; }
.ai-name { font-size: 30rpx; font-weight: bold; margin-right: 16rpx; }
.ai-phone { font-size: 26rpx; color: #666; }
.ai-tag { background: #FFE7D6; color: var(--theme); font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 14rpx; margin-left: 12rpx; }
.ai-default { background: var(--theme); color: #fff; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 14rpx; margin-left: 12rpx; }
.ai-detail { font-size: 26rpx; color: #666; margin-top: 10rpx; }
.ai-ops { position: absolute; top: 24rpx; right: 24rpx; display: flex; }
.ai-edit { font-size: 24rpx; color: var(--theme); margin-right: 24rpx; }
.ai-del { font-size: 24rpx; color: var(--sub); }
.ai-setdef { margin-top: 16rpx; font-size: 24rpx; color: var(--theme); }
.ai-setdef.on { color: var(--sub); }

.add-btn { background: var(--theme); color: #fff; text-align: center; padding: 28rpx; border-radius: var(--r-md); font-size: 30rpx; margin-top: 20rpx; box-shadow: var(--shadow-sm); transition: transform 0.12s ease; }

/* 表单 */
.addr-form { background: var(--card); border-radius: var(--r-lg); padding: 10rpx 24rpx; box-shadow: var(--shadow-sm); }
.form-row { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid var(--line); }
.form-label { width: 160rpx; font-size: 28rpx; color: #333; }
.form-input { flex: 1; font-size: 28rpx; }
.loc-btn { flex: 1; color: var(--theme); font-size: 28rpx; }
.form-picker { flex: 1; font-size: 28rpx; color: #333; }
.form-picker.placeholder { color: var(--sub); }
.tag-group { flex: 1; display: flex; }
.form-tag { background: #f3f3f3; color: #555; font-size: 26rpx; padding: 10rpx 30rpx; border-radius: 28rpx; margin-right: 16rpx; transition: transform 0.12s ease; }
.form-tag.active { background: var(--theme); color: #fff; }

.form-btns { display: flex; margin-top: 40rpx; padding-bottom: 40rpx; }
.form-cancel { flex: 1; background: #f3f3f3; color: #666; text-align: center; padding: 26rpx; border-radius: 40rpx; margin-right: 20rpx; font-size: 30rpx; }
.form-save { flex: 1; background: var(--theme); color: #fff; text-align: center; padding: 26rpx; border-radius: 40rpx; font-size: 30rpx; }
