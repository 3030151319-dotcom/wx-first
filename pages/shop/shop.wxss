/* pages/shop/shop.wxss */
.shop-page { display: flex; flex-direction: column; height: 100vh; background: #fff; }

/* 店铺头部 */
.shop-header { display: flex; padding: 24rpx; background: linear-gradient(135deg, var(--theme) 0%, var(--theme-light) 100%); }
.shop-logo-lg { width: 110rpx; height: 110rpx; border-radius: 14rpx; overflow: hidden; background: #f3f3f3; margin-right: 20rpx; flex-shrink: 0; box-shadow: var(--shadow-sm); }
.shop-logo-lg-img { width: 100%; height: 100%; display: block; }
.shop-head-info { flex: 1; min-width: 0; color: #fff; }
.shop-name { font-size: 32rpx; font-weight: bold; }
.shop-sub { display: flex; margin: 10rpx 0; font-size: 24rpx; }
.shop-sub text { margin-right: 18rpx; }
.shop-sub .rating { color: #FFE07A; }
.shop-extra { display: flex; font-size: 24rpx; }
.shop-extra text { margin-right: 18rpx; }

.shop-notice { background: #FFF6E9; color: #B26A00; font-size: 24rpx; padding: 14rpx 24rpx; }

/* 满减 + 领券 */
.shop-promo { background: #fff; padding: 16rpx 24rpx; border-bottom: 1rpx solid var(--line); }
.promo-acts { display: flex; flex-wrap: wrap; margin-bottom: 12rpx; }
.promo-coupons { display: flex; flex-wrap: wrap; }
.cp-item { display: flex; align-items: center; background: var(--theme-bg); border: 1rpx solid #FFD5C7; border-radius: 10rpx; padding: 8rpx 14rpx; margin: 0 16rpx 12rpx 0; }
.cp-amt { color: var(--theme); font-size: 28rpx; font-weight: bold; }
.cp-cond { color: #b86b53; font-size: 20rpx; margin: 0 10rpx; }
.cp-btn { background: var(--theme); color: #fff; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; transition: transform 0.12s ease; }
.cp-btn.got { background: #ccc; }

/* 主体：左分类 + 右商品 */
.body { flex: 1; display: flex; overflow: hidden; }
.side-cat { width: 180rpx; height: 100%; background: #f7f7f7; }
.side-item { padding: 34rpx 12rpx; text-align: center; font-size: 26rpx; color: #555; border-left: 6rpx solid transparent; transition: background 0.15s ease, color 0.15s ease; }
.side-item.active { background: #fff; color: var(--theme); font-weight: bold; border-left-color: var(--theme); }

.goods-area { flex: 1; height: 100%; padding: 0 20rpx; }
.cat-title { font-size: 26rpx; color: var(--sub); padding: 24rpx 0 12rpx; font-weight: bold; }
.goods-bottom-space { height: 40rpx; }

/* 底部购物车栏 */
.cart-bar { height: 100rpx; background: #2b2b2b; display: flex; align-items: center; padding: 0 20rpx; }
.cart-icon {
  position: relative; width: 90rpx; height: 90rpx; border-radius: 50%; background: #555;
  display: flex; align-items: center; justify-content: center; margin-top: -20rpx; border: 6rpx solid #2b2b2b;
}
.cart-icon.has { background: var(--theme); }
.ci-emoji { font-size: 44rpx; }
.cart-badge {
  position: absolute; top: -6rpx; right: -6rpx; background: #fff; color: var(--theme);
  font-size: 20rpx; min-width: 30rpx; height: 30rpx; line-height: 30rpx; border-radius: 15rpx;
  text-align: center; padding: 0 4rpx; border: 1rpx solid var(--theme);
}
.cart-price { flex: 1; color: #fff; padding-left: 24rpx; }
.price-num { font-size: 34rpx; font-weight: bold; }
.price-sub { font-size: 20rpx; color: #bbb; margin-left: 12rpx; }
.price-tip { font-size: 26rpx; color: #bbb; }
.checkout-btn { background: #666; color: #fff; font-size: 30rpx; padding: 0 40rpx; height: 100rpx; line-height: 100rpx; }
.checkout-btn.active { background: var(--theme); }

/* 购物车悬浮弹窗 */
.cart-sheet { padding-bottom: env(safe-area-inset-bottom); }
.cart-sheet-body { max-height: 50vh; }
.sheet-clear { font-size: 24rpx; color: var(--sub); }
.cs-item { display: flex; align-items: center; padding: 24rpx; border-bottom: 1rpx solid var(--line); }
.cs-img { width: 90rpx; height: 90rpx; border-radius: 10rpx; margin-right: 18rpx; flex-shrink: 0; }
.cs-info { flex: 1; min-width: 0; }
.cs-name { font-size: 28rpx; }
.cs-spec { font-size: 22rpx; color: var(--sub); margin: 4rpx 0; }
.cs-price { font-size: 28rpx; color: var(--theme); font-weight: bold; }

/* 规格选择弹窗 */
.spec-sheet { padding-bottom: env(safe-area-inset-bottom); }
.spec-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-right: 20rpx; flex-shrink: 0; }
.spec-head-info { flex: 1; min-width: 0; }
.spec-name { font-size: 30rpx; font-weight: bold; }
.spec-price { font-size: 32rpx; color: var(--theme); font-weight: bold; margin-top: 8rpx; }
.spec-body { max-height: 40vh; padding: 0 24rpx; }
.spec-group { padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.spec-group-title { font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; }
.spec-opts { display: flex; flex-wrap: wrap; }
.spec-opt { background: #f3f3f3; color: #555; font-size: 26rpx; padding: 12rpx 28rpx; border-radius: 28rpx; margin: 0 16rpx 16rpx 0; transition: transform 0.12s ease; }
.spec-opt.active { background: var(--theme); color: #fff; }
.spec-foot { display: flex; align-items: center; padding: 20rpx 24rpx; border-top: 1rpx solid var(--line); }
.spec-foot-price { flex: 1; font-size: 34rpx; color: var(--theme); font-weight: bold; }
.spec-add { background: var(--theme); color: #fff; font-size: 28rpx; padding: 18rpx 50rpx; border-radius: 40rpx; margin-left: 20rpx; }

/* 骨架屏 */
.shop-skeleton { padding: 24rpx; }
.sk-head { height: 140rpx; margin-bottom: 24rpx; border-radius: var(--r-md); }
.sk-row { display: flex; }
.sk-side { width: 180rpx; height: 600rpx; margin-right: 20rpx; border-radius: var(--r-sm); }
.sk-goods { flex: 1; }
.sk-gitem { height: 180rpx; margin-bottom: 24rpx; border-radius: var(--r-sm); }
