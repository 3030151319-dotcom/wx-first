/* pages/search/search.wxss */
.search-page { min-height: 100vh; background: var(--bg); }

.search-head { display: flex; align-items: center; background: linear-gradient(180deg, var(--theme) 0%, var(--theme-light) 100%); padding: 16rpx 24rpx; }
.search-box {
  flex: 1; background: #fff; border-radius: 36rpx; height: 68rpx;
  display: flex; align-items: center; padding: 0 24rpx;
}
.search-icon { color: var(--sub); margin-right: 10rpx; }
.search-input { flex: 1; font-size: 28rpx; }
.cancel { color: #fff; font-size: 28rpx; margin-left: 20rpx; }

/* 联想 */
.suggest { background: var(--card); }
.sg-item { display: flex; align-items: center; padding: 20rpx 24rpx; border-bottom: 1rpx solid var(--line); }
.sg-img { width: 72rpx; height: 72rpx; border-radius: 8rpx; margin-right: 18rpx; flex-shrink: 0; }
.sg-text { flex: 1; min-width: 0; }
.sg-name { font-size: 28rpx; }
.sg-sub { font-size: 22rpx; color: var(--sub); margin-top: 4rpx; }

/* 历史 */
.history { background: var(--card); padding: 24rpx; margin-top: 2rpx; }
.his-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.his-head text:first-child { font-size: 28rpx; font-weight: bold; }
.his-clear { font-size: 24rpx; color: var(--sub); }
.his-tags { display: flex; flex-wrap: wrap; }
.his-tag { background: #f3f3f3; color: #666; font-size: 24rpx; padding: 12rpx 24rpx; border-radius: 28rpx; margin: 0 16rpx 16rpx 0; }

/* 结果 */
.results { padding: 20rpx; }
.res-section { background: var(--card); border-radius: var(--r-lg); padding: 0 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); }
.res-title { font-size: 28rpx; font-weight: bold; padding: 20rpx 0 10rpx; }
.res-goods { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; transition: transform 0.12s ease, background 0.12s ease; }
.rg-img { width: 96rpx; height: 96rpx; border-radius: 10rpx; margin-right: 18rpx; flex-shrink: 0; }
.rg-info { flex: 1; min-width: 0; }
.rg-name { font-size: 28rpx; }
.rg-sub { font-size: 22rpx; color: var(--sub); margin: 4rpx 0; }
.rg-price { font-size: 28rpx; color: var(--theme); font-weight: bold; }
