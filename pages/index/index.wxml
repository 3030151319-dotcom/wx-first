<!-- pages/index/index.wxml -->
<!-- 首页：定位栏 + 搜索入口 + 横向分类导航 + 排序栏 + 店铺列表（双列瀑布方形大图卡 / 骨架屏 / 下拉刷新 / 上滑加载） -->
<view class="home page-enter">
  <!-- 定位栏 -->
  <view class="top-bar">
    <view class="location" bindtap="chooseCity">
      <text class="loc-icon">📍</text>
      <text class="loc-text">{{city}}</text>
      <text class="loc-arrow">▾</text>
    </view>
    <text class="top-title">美团外卖</text>
    <view class="addr-switch" bindtap="goAddress">收货地址</view>
  </view>

  <!-- 搜索入口（点击进入搜索页：联想 + 历史） -->
  <view class="search-wrap">
    <view class="search-box" bindtap="goSearch">
      <text class="search-icon">🔍</text>
      <text class="search-ph">搜索商家、商品</text>
    </view>
  </view>

  <!-- 横向品类导航 -->
  <scroll-view class="cat-nav" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cat-item {{activeCat === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="selectCat"
    >
      <text class="cat-icon">{{item.icon}}</text>
      <text class="cat-name">{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 排序栏 -->
  <view class="sort-bar">
    <view
      wx:for="{{sortTabs}}"
      wx:key="id"
      class="sort-item {{sortType === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="changeSort"
    >{{item.name}}</view>
  </view>

  <!-- 商家列表：双列瀑布，方形大图卡 -->
  <view class="shop-list">
    <!-- 首屏骨架屏（双列占位） -->
    <view wx:if="{{loading && showShops.length === 0}}" class="shop-cols">
      <view class="col">
        <view class="sk-item" wx:for="{{skItems}}" wx:key="*this">
          <view class="sk-box sk-cover"></view>
          <view class="sk-box sk-line" style="width:72%"></view>
          <view class="sk-box sk-line" style="width:52%"></view>
        </view>
      </view>
      <view class="col">
        <view class="sk-item" wx:for="{{skItems}}" wx:key="*this">
          <view class="sk-box sk-cover"></view>
          <view class="sk-box sk-line" style="width:72%"></view>
          <view class="sk-box sk-line" style="width:52%"></view>
        </view>
      </view>
    </view>

    <block wx:else>
      <view class="shop-cols">
        <view class="col">
          <view
            wx:for="{{leftCol}}"
            wx:key="id"
            class="shop-card"
            hover-class="press-card"
            data-id="{{item.id}}"
            bindtap="goShop"
          >
            <view class="shop-cover">
              <image class="shop-cover-img" src="{{item.img}}" mode="aspectFill" lazy-load="{{true}}" />
            </view>
            <view class="shop-info">
              <view class="shop-name ellipsis">{{item.name}}</view>
              <view class="shop-meta">
                <text class="rating">★ {{item.rating}}</text>
                <text class="sales">月售{{item.monthSales}}</text>
                <text class="distance">{{item.distance}}km</text>
              </view>
              <view class="shop-tags">
                <text wx:for="{{item.activities}}" wx:for-item="t" wx:key="*this" class="tag">{{t.label}}</text>
              </view>
              <view class="shop-delivery">
                <text class="fee">{{item.deliveryFee === 0 ? '免配送费' : '配送 ¥' + item.deliveryFee}}</text>
                <text class="time">{{item.deliveryTime}}分钟</text>
                <text class="min">起送 ¥{{item.minOrder}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="col">
          <view
            wx:for="{{rightCol}}"
            wx:key="id"
            class="shop-card"
            hover-class="press-card"
            data-id="{{item.id}}"
            bindtap="goShop"
          >
            <view class="shop-cover">
              <image class="shop-cover-img" src="{{item.img}}" mode="aspectFill" lazy-load="{{true}}" />
            </view>
            <view class="shop-info">
              <view class="shop-name ellipsis">{{item.name}}</view>
              <view class="shop-meta">
                <text class="rating">★ {{item.rating}}</text>
                <text class="sales">月售{{item.monthSales}}</text>
                <text class="distance">{{item.distance}}km</text>
              </view>
              <view class="shop-tags">
                <text wx:for="{{item.activities}}" wx:for-item="t" wx:key="*this" class="tag">{{t.label}}</text>
              </view>
              <view class="shop-delivery">
                <text class="fee">{{item.deliveryFee === 0 ? '免配送费' : '配送 ¥' + item.deliveryFee}}</text>
                <text class="time">{{item.deliveryTime}}分钟</text>
                <text class="min">起送 ¥{{item.minOrder}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 网络异常重试 -->
      <view wx:if="{{netError}}" class="net-error">
        <text class="ne-icon">📡</text>
        <text class="ne-text">网络开了小差，加载失败</text>
        <view class="ne-btn" hover-class="btn-scale" bindtap="retry">点击重试</view>
      </view>

      <!-- 底部提示 / 空状态 -->
      <view wx:if="{{hasMore && showShops.length > 0}}" class="list-tip">上滑加载更多</view>
      <view wx:elif="{{!hasMore && showShops.length > 0}}" class="list-tip">没有更多了~</view>
      <mt-empty wx:elif="{{showShops.length === 0 && !netError}}" icon="🍽️" text="没有找到相关商家~" btn-text="重新加载" bind:btn="retry" />
    </block>
  </view>
  <view class="bottom-space"></view>
</view>
